@keyframes rise {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
@keyframes satellite-land {
  from {
    opacity: 0;
    transform: translate3d(var(--launch-x), var(--launch-y), -120px) scale(0.2)
      rotate(12deg);
  }
  to {
    opacity: 1;
    transform: translate3d(0, 0, 0) scale(1) rotate(0);
  }
}
@keyframes satellite-drift {
  0%,
  100% {
    translate: 0 0;
  }
  35% {
    translate: 3px -5px;
  }
  70% {
    translate: -3px 3px;
  }
}
@keyframes centre-focus {
  from {
    opacity: 0;
    transform: translateY(20px) scale(0.93);
    filter: blur(4px);
  }
  to {
    opacity: 1;
    transform: none;
    filter: blur(0);
  }
}
@keyframes centre-type {
  from {
    letter-spacing: -3px;
    opacity: 0.1;
  }
  to {
    letter-spacing: -2.1px;
    opacity: 1;
  }
}
@keyframes mobile-tool-fade {
  from {
    opacity: 0;
    transform: translateY(20px) scale(0.8);
  }
  to {
    opacity: 1;
    transform: none;
  }
}
@keyframes mobile-tool-land {
  from {
    opacity: 0;
    transform: translate3d(var(--mobile-launch-x), var(--mobile-launch-y), 0)
      scale(0.25);
  }
  to {
    opacity: 1;
    transform: none;
  }
}
@keyframes mobile-centre-type {
  from {
    letter-spacing: -2px;
    opacity: 0.2;
  }
  to {
    letter-spacing: -1.3px;
    opacity: 1;
  }
} /* Shared accessibility and theme behavior. */
