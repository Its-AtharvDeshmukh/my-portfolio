/* The toolkit below is preserved from the approved version. */

.skills-section {
  min-height: 100svh;
  padding: 96px 0 36px;
  display: flex;
  align-items: center;
  background: var(--bg);
}
.skills-section > .shell {
  width: min(1300px, calc(100% - 64px));
}
.skill-universe {
  height: clamp(600px, 78svh, 760px);
  position: relative;
  container-type: size;
  perspective: 1400px;
  isolation: isolate;
}
.skill-field-grid {
  position: absolute;
  inset: 11% 2%;
  border: 1px solid color-mix(in srgb, var(--line), transparent 50%);
  background: radial-gradient(ellipse, #91b9cc0a, transparent 65%);
  border-radius: 50%;
  rotate: -14deg;
  z-index: -1;
}
.skill-intro {
  position: absolute;
  top: 31%;
  left: 25%;
  right: 25%;
  text-align: center;
  z-index: 3;
}
.skill-intro .eyebrow {
  font-size: 9px;
  margin-bottom: 19px;
}
.skill-intro h2 {
  font-size: clamp(34px, 3.6vw, 51px);
  letter-spacing: -2.1px;
  line-height: 1.08;
  margin-bottom: 22px;
}
.skill-intro h2 > span {
  color: var(--muted);
}
.skill-description {
  font-size: 13px;
  line-height: 1.6;
  color: var(--muted);
  max-width: 360px;
  min-height: 63px;
  margin: 0 auto 18px;
  animation: rise 0.25s var(--ease);
}
.skill-selected {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  border: 1px solid var(--line);
  background: var(--surface);
  padding: 8px 12px;
  border-radius: 999px;
  color: var(--accent);
  font-size: 10px;
}
.skill-selected > .icon {
  width: 14px;
  height: 14px;
}
.skill-intro > small {
  display: block;
  font-size: 9px;
  color: var(--muted);
  margin-top: 17px;
}
.skill-satellite {
  position: absolute;
  left: var(--x);
  top: var(--y);
  translate: -50% -50%;
  width: var(--size);
  display: flex;
  align-items: center;
  flex-direction: column;
  gap: 9px;
  background: none;
  padding: 0;
  color: var(--muted);
  font-size: 9px;
  white-space: nowrap;
  z-index: 1;
  transform-style: preserve-3d;
}
.satellite-face {
  width: var(--size);
  height: var(--size);
  display: grid;
  place-items: center;
  border: 1px solid var(--line);
  border-radius: 26%;
  background: var(--surface);
  color: var(--skill-color);
  box-shadow: 0 15px 30px #183a4810;
  rotate: var(--rotate);
  opacity: var(--depth);
  overflow: hidden;
  transition:
    box-shadow 0.25s,
    opacity 0.25s;
}
.satellite-face > img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}
.satellite-face > .icon {
  width: 48%;
  height: 48%;
}
.skill-universe.is-visible .skill-satellite {
  animation: satellite-land 1.05s var(--ease) var(--land-delay) both;
}
.skill-universe.is-visible .satellite-face {
  animation: satellite-drift var(--drift-duration) ease-in-out
    var(--drift-delay) infinite;
}
.skill-satellite:hover,
.skill-satellite:focus-visible,
.skill-satellite[aria-pressed="true"] {
  z-index: 5;
  color: var(--accent);
}
.skill-satellite:hover .satellite-face,
.skill-satellite:focus-visible .satellite-face,
.skill-satellite[aria-pressed="true"] .satellite-face {
  opacity: 1;
  box-shadow: 0 16px 34px #326e7d22;
}
.skill-satellite:hover .satellite-face {
  animation-play-state: paused;
}
.toolkit-footnote {
