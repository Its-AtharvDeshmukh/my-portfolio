/* Atharv Studio 13. One layout system; the preserved toolkit follows below. */
:root {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  background: #f8f9ff;
  color: #171d2f;
}
* {
  box-sizing: border-box;
  scrollbar-width: none;
}
*::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
}
html {
  scroll-behavior: auto;
}
body {
  margin: 0;
}
button,
input {
  font: inherit;
}
button,
a {
  -webkit-tap-highlight-color: transparent;
  touch-action: manipulation;
}
button {
  border: 0;
  cursor: pointer;
  color: inherit;
}
a {
  color: inherit;
  text-decoration: none;
}
button:disabled {
  opacity: 0.35;
  cursor: default;
}
img,
video {
  display: block;
  max-width: 100%;
}
h1,
h2,
h3,
p {
  margin: 0;
}
p {
  line-height: 1.7;
}
button:focus-visible,
a:focus-visible,
input:focus-visible,
summary:focus-visible {
  outline: 3px solid var(--accent);
  outline-offset: 4px;
}
main:focus,
section[tabindex]:focus,
h2[tabindex]:focus {
  outline: 0;
}
[hidden] {
  display: none !important;
}
summary {
  cursor: pointer;
  list-style: none;
}
summary::-webkit-details-marker {
  display: none;
}
.portfolio {
  --bg: #f8f9ff;
  --surface: #eef1fb;
  --surface2: #e2e9f8;
  --ink: #171d2f;
  --muted: #667087;
  --line: #dce2ef;
  --accent: #3657ef;
  --blue: #3657ef;
  --radius: 24px;
  --radius-sm: 24px;
  --ease: cubic-bezier(0.2, 0.75, 0.2, 1);
  background: var(--bg);
  color: var(--ink);
  overflow-x: clip;
  isolation: isolate;
}
.portfolio[data-appearance="midnight"] {
  --bg: #0e1423;
  --surface: #182136;
  --surface2: #222e46;
  --ink: #f1f4ff;
  --muted: #b2bed4;
  --line: #344059;
  --accent: #9caeff;
  --blue: #9caeff;
}
.shell {
  width: min(1240px, calc(100% - 96px));
  margin-inline: auto;
}
.section-space {
  padding: 84px 0 40px;
}
.icon {
  display: inline-block;
  width: 22px;
  height: 22px;
  vertical-align: middle;
  flex-shrink: 0;
}
.eyebrow {
  font-size: 11px;
  line-height: 1.5;
  text-transform: uppercase;
  letter-spacing: 1.6px;
  font-weight: 600;
  color: var(--muted);
  margin-bottom: 20px;
}
.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 32px;
  margin-bottom: 36px;
}
.section-head h2 {
  font-size: clamp(34px, 3.6vw, 48px);
  line-height: 1.1;
  letter-spacing: -1.9px;
  font-weight: 600;
}
.section-head h2 > span {
  display: block;
  color: var(--accent);
}
.section-intro {
  max-width: 340px;
}
.section-intro p {
  font-size: 15px;
  color: var(--muted);
  line-height: 1.8;
}
.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 11px;
  min-height: 48px;
  padding: 14px 22px;
  border: 1px solid transparent;
  border-radius: var(--radius);
  font-size: 13px;
  font-weight: 550;
  line-height: 1.2;
  transition:
    background 0.2s,
    transform 0.2s,
    border-color 0.2s;
}
.button .icon {
  width: 17px;
  height: 17px;
}
.button:hover {
  transform: translateY(-2px);
}
.button.primary {
  background: #3657ef;
  color: #fff;
}
.button.primary:hover {
  background: #2647dd;
}
.button.secondary {
  background: var(--bg);
  border-color: var(--line);
  color: var(--ink);
}
.text-link {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 0;
  background: none;
  color: var(--accent);
  font-size: 13px;
  line-height: 1.6;
}
.text-link > .icon {
  width: 16px;
  height: 16px;
}
.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
.tag-list > span {
  font-size: 11px;
  padding: 7px 11px;
  line-height: 1.3;
  border: 1px solid var(--line);
  border-radius: var(--radius);
  background: var(--surface);
  color: var(--muted);
}
.round-button {
  display: grid;
  place-items: center;
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: var(--surface2);
}
.round-button .icon {
  width: 18px;
  height: 18px;
}
.turn-back {
  rotate: 180deg;
}
.skip-link {
  position: fixed;
  left: 20px;
  top: -100px;
  background: var(--ink);
  color: var(--bg);
  padding: 14px 20px;
  z-index: 100;
  border-radius: var(--radius);
}
.skip-link:focus {
  top: 14px;
}
[data-reveal] {
  opacity: 0;
  transform: translateY(18px);
  transition:
    opacity 0.65s var(--ease),
    transform 0.65s var(--ease);
}
[data-reveal].is-visible {
  opacity: 1;
  transform: none;
}
/* Navigation */
.site-header {
  position: fixed;
  inset: 0 0 auto;
  z-index: 50;
  background: color-mix(in srgb, var(--bg), transparent 8%);
  border-bottom: 1px solid var(--line);
  backdrop-filter: blur(18px) saturate(140%);
}
.nav-shell {
  width: min(1240px, calc(100% - 96px));
  height: 72px;
  margin: auto;
  display: flex;
  align-items: center;
  gap: 20px;
}
.brand {
  margin-right: auto;
  display: flex;
  align-items: center;
}
.ad-mark {
  font-size: 33px;
  letter-spacing: -2px;
  font-weight: 650;
  line-height: 1;
}
.ad-mark > span {
  color: var(--accent);
}
.site-header nav {
  display: flex;
  align-items: center;
  gap: 2px;
}
.site-header nav > a {
  font-size: 12px;
  color: var(--muted);
  padding: 12px 14px;
  border-radius: var(--radius);
  transition:
    background 0.2s,
    color 0.2s;
}
.site-header nav > a:hover {
  background: var(--surface);
  color: var(--ink);
}
.site-header nav > a[aria-current] {
  background: var(--surface);
  color: var(--accent);
}
.site-header .nav-contact {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: var(--accent);
}
.nav-contact .icon {
  width: 14px;
  height: 14px;
}
.nav-utilities {
  display: flex;
  align-items: center;
  gap: 12px;
}
.appearance-button {
  width: 38px;
  height: 40px;
  background: none;
  display: grid;
  place-items: center;
}
.appearance-symbol {
  width: 17px;
  height: 17px;
  border: 1px solid var(--muted);
  border-radius: 50%;
  background: linear-gradient(90deg, var(--muted) 50%, transparent 50%);
}
.nav-resume {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  border-radius: var(--radius);
  background: var(--ink);
  color: var(--bg);
  font-size: 12px;
  padding: 12px 18px;
}
.nav-resume .icon {
  width: 15px;
  height: 15px;
}
.menu-button,
.mobile-resume {
  display: none;
}
/* Introduction */
.hero {
  padding: 112px 0 40px;
  background:
    radial-gradient(
      ellipse at 82% 40%,
      color-mix(in srgb, var(--accent), transparent 95%),
      transparent 60%
    ),
    var(--bg);
}
.hero-layout {
  display: grid;
  grid-template-columns: 1.05fr 1fr;
  align-items: center;
  gap: 80px;
}
.hero-copy > .eyebrow {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 10px;
  letter-spacing: 1.3px;
}
.live-dot {
  width: 6px;
  height: 6px;
  background: var(--accent);
  border-radius: 50%;
  box-shadow: 0 0 0 5px color-mix(in srgb, var(--accent), transparent 92%);
}
.hero h1 {
  font-size: clamp(58px, 5.6vw, 82px);
  line-height: 0.99;
  letter-spacing: -4px;
  font-weight: 600;
  margin-bottom: 26px;
}
.hero h1 > span {
  color: var(--accent);
}
.hero-statement {
  font-size: 27px;
  line-height: 1.25;
  letter-spacing: -0.8px;
  font-weight: 500;
  margin-bottom: 18px;
}
.hero-description {
  font-size: 15px;
  color: var(--muted);
  line-height: 1.8;
  max-width: 470px;
}
.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 28px;
}
.hero-context {
  display: flex;
  flex-direction: column;
  gap: 9px;
  margin-top: 28px;
  font-size: 12px;
  color: var(--muted);
}
.hero-context > span {
  display: flex;
  gap: 7px;
  align-items: center;
}
.hero-context .icon {
  width: 14px;
  height: 14px;
}
.hero-visual {
  min-width: 0;
}
.hero-photo {
  height: 435px;
  border-radius: var(--radius);
  overflow: hidden;
  background: var(--surface);
}
.hero-photo > img {
  height: 100%;
  width: 100%;
  object-fit: cover;
  object-position: 53% 43%;
}
.intro-link {
  display: flex;
  align-items: center;
  gap: 15px;
  width: 100%;
  padding: 19px 0 10px;
  background: none;
  text-align: left;
}
.intro-play {
  display: grid;
  place-items: center;
  width: 45px;
  height: 45px;
  border-radius: 50%;
  background: var(--accent);
  color: var(--bg);
}
.intro-play .icon {
  width: 17px;
  height: 17px;
}
.intro-link > span:nth-child(2) {
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.intro-link strong {
  font-size: 14px;
  font-weight: 550;
}
.intro-link small {
  font-size: 11px;
  color: var(--muted);
}
.intro-link > .icon {
  width: 18px;
  margin-left: auto;
  transition: translate 0.2s;
}
.intro-link:hover > .icon {
  translate: 4px 0;
}
.hero-caption {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 11px;
  color: var(--muted);
  margin-top: 9px;
}
.hero-caption .icon {
  width: 15px;
  height: 15px;
}
/* Projects */
.work-section {
  background: var(--surface);
}
.project-layout {
  display: block;
  grid-template-columns: 280px minmax(0, 1fr);
  gap: 48px;
  align-items: start;
}
.project-index {
  display: grid;
  gap: 12px;
  grid-template-columns: repeat(4,minmax(0,1fr));
  margin-bottom: 26px;
}
.project-index > button {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 16px 14px;
  border: 1px solid var(--line);
  border-radius: var(--radius);
  background: var(--bg);
  text-align: left;
  transition:
    background 0.2s,
    border-color 0.2s,
    transform 0.2s;
  justify-content: center;
}
.project-index > button:hover {
  transform: translateX(3px);
  border-color: var(--accent);
}
.project-index > button[aria-pressed="true"] {
  border-color: var(--accent);
  background: color-mix(in srgb, var(--bg), var(--accent) 4%);
}
.project-index-icon {
  display: grid;
  place-items: center;
  width: 40px;
  height: 40px;
  border-radius: var(--radius);
  background: var(--surface);
  color: var(--accent);
}
.project-index-icon > .icon {
  width: 22px;
  height: 22px;
}
.project-index > button > span:nth-child(2) {
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.project-index strong {
  font-size: 17px;
  font-weight: 550;
}
.project-index small {
  font-size: 11px;
  color: var(--muted);
}
.project-index > button > .icon {
  width: 15px;
  height: 15px;
  margin-left: auto;
  color: var(--muted);
  display: none;
}
.index-source {
  display: none;
  align-items: center;
  justify-content: space-between;
  padding: 14px 18px;
  color: var(--muted);
  font-size: 12px;
}
.index-source > .icon {
  width: 15px;
  height: 15px;
}
.project-view {
  min-width: 0;
  animation: panel-in 0.35s var(--ease) both;
  display: grid;
  grid-template-columns: 1fr 1.25fr;
  gap: 36px;
  align-items: start;
}
.project-media {
  overflow: hidden;
  border: 1px solid var(--line);
  border-radius: var(--radius);
  background: #11182c;
  order: 2;
}
.project-media .clean-player {
  height: auto;
}
.project-media .player-canvas {
  aspect-ratio: 16/9;
  flex: auto;
  height: auto;
}
.project-cover {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: var(--surface);
}
.project-cover > img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}
.cover-status {
  position: absolute;
  top: 18px;
  left: 18px;
  font-size: 8px;
  letter-spacing: 1.5px;
  padding: 8px 11px;
  border-radius: var(--radius);
  background: #ffffffd9;
  color: #1b283a;
}
.project-concept {
  padding: 0;
  width: 100%;
  background: var(--bg);
  text-align: left;
}
.project-concept > .project-cover {
  height: auto;
  aspect-ratio: 16/9;
}
.project-concept > span {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16px 20px;
  color: var(--accent);
  font-size: 13px;
}
.project-concept > span > .icon {
  width: 16px;
}
.project-info {
  padding-top: 6px;
  order: 1;
}
.project-info > .eyebrow {
  font-size: 10px;
  margin-bottom: 11px;
}
.project-info h3 {
  font-size: 29px;
  letter-spacing: -0.8px;
  line-height: 1.15;
  margin-bottom: 13px;
}
.project-info > p:not(.eyebrow) {
  font-size: 15px;
  color: var(--muted);
  max-width: 680px;
}
.project-role {
  margin: 22px 0 18px;
  padding-top: 20px;
  border-top: 1px solid var(--line);
}
.project-role > span {
  font-size: 12px;
  font-weight: 600;
}
.project-role p {
  font-size: 13px;
  color: var(--muted);
  line-height: 1.8;
  margin-top: 8px;
}
.project-actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 18px;
  margin-top: 24px;
}
.project-actions .button {
  min-height: 44px;
  font-size: 12px;
}
.repository-collection {
  margin-top: 40px;
  border-top: 1px solid var(--line);
}
.repository-collection > summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24px 0;
  font-size: 16px;
  letter-spacing: -0.3px;
}
.repository-collection > summary > .icon {
  width: 20px;
  height: 20px;
}
.repository-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14px;
  padding-bottom: 12px;
}
.repository-grid > a {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 19px;
  border: 1px solid var(--line);
  border-radius: var(--radius);
  background: var(--bg);
}
.repository-grid > a > .icon:first-child {
  width: 22px;
  color: var(--accent);
}
.repository-grid > a > .icon:last-child {
  width: 14px;
  margin-left: auto;
}
.repository-grid > a > span {
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.repository-grid strong {
  font-size: 13px;
  font-weight: 550;
}
.repository-grid small {
  font-size: 11px;
  color: var(--muted);
  line-height: 1.5;
}
/* Players: a single playback action, with volume controls outside the video. */
.clean-player {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  background: #11182c;
  color: #f1f4ff;
  position: relative;
}
.player-canvas {
  position: relative;
  flex: 1;
  min-height: 0;
  width: 100%;
  overflow: hidden;
  background: #11182c;
}
.player-canvas > video {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: contain;
}
.player-poster {
  position: absolute;
  inset: 0;
  padding: 0;
  width: 100%;
  height: 100%;
  background: var(--surface);
}
.player-poster > img,
.player-poster > .project-cover {
  width: 100%;
  height: 100%;
  object-fit: contain;
}
.play-disc {
  position: absolute;
  bottom: 7%;
  right: 5%;
  width: 52px;
  height: 52px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  background: #ffffffeb;
  color: #1b2a43;
  box-shadow: 0 8px 24px #10244018;
  transition: scale 0.2s;
}
.play-disc > .icon {
  width: 19px;
  height: 19px;
}
.player-poster:hover .play-disc {
  scale: 1.07;
}
.player-controls {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  height: 44px;
  flex-shrink: 0;
  padding: 0 16px;
  background: #11182c;
  border-top: 1px solid #ffffff0c;
  color: #f1f4ff;
}
.player-controls > button {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  min-height: 36px;
  padding: 4px;
  background: none;
  color: inherit;
  font-size: 11px;
}
.player-controls .icon {
  width: 16px;
  height: 16px;
}
.volume-control {
  display: flex;
  align-items: center;
  gap: 8px;
}
.volume-control > button {
  display: grid;
  place-items: center;
  background: none;
  color: inherit;
  width: 32px;
  height: 36px;
}
.volume-control input {
  width: 75px;
  height: 3px;
  accent-color: #afc2f4;
  cursor: pointer;
}
.minimal-controls {
  justify-content: flex-end;
}
.minimal-controls .corner-playback {
  width: 34px;
  height: 34px;
  min-height: 34px;
  display: grid;
  place-items: center;
  border: 1px solid #ffffff30;
  background: #ffffff10;
  border-radius: var(--radius);
}
.youtube-host,
.youtube-host iframe {
  width: 100%;
  height: 100%;
  position: absolute;
  inset: 0;
  border: 0;
}
.player-error {
  font-size: 12px;
  line-height: 1.7;
  padding: 15px 18px;
  margin: 0;
  background: #11182c;
  color: #dbe7ff;
}
.player-error a {
  text-decoration: underline;
}
/* A short, active explanation of the process. */
.approach-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 18px;
}
.approach-card {
  display: flex;
  flex-direction: column;
  min-width: 0;
  padding: 25px 23px;
  border: 1px solid var(--line);
  border-radius: var(--radius);
  background: var(--surface);
}
.approach-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: var(--accent);
}
.approach-card-top > .icon {
  width: 25px;
  height: 25px;
}
.approach-card-top > span {
  font-size: 11px;
  color: var(--muted);
}
.stage-art {
  display: block;
  stroke: var(--accent);
  stroke-width: 1.5;
  fill: none;
  width: 100%;
  height: 100px;
  margin: 20px 0;
  opacity: 0.8;
}
.stage-pulse {
  fill: var(--surface2);
}
.approach-card h3 {
  font-size: 22px;
  line-height: 1.2;
  letter-spacing: -0.5px;
  margin-bottom: 13px;
}
.approach-card p {
  font-size: 13px;
  color: var(--muted);
  line-height: 1.8;
  margin-bottom: 24px;
}
.approach-card .text-link {
  margin-top: auto;
  font-size: 12px;
}
.motion-on .approach-card.is-visible .stage-pulse {
  animation: signal-pulse 3s ease-in-out infinite;
}
.motion-on .approach-card.is-visible .stage-flow {
  stroke-dasharray: 8 5;
  animation: signal-flow 2s linear infinite;
}
.motion-on .approach-card.is-visible .stage-tick {
  stroke-dasharray: 70;
  animation: signal-check 1s var(--ease) both;
}
/* Publication: actual article pages. */
.research-section {
  background: var(--surface);
}
.publication-layout {
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: center;
  gap: 64px;
}
.publication-label {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 11px;
  color: var(--accent);
  margin-bottom: 20px;
}
.publication-label > .icon {
  width: 16px;
  height: 16px;
}
